# Copy to .env.local (git-ignored) to override the local defaults in src/config.ts, or to build for another environment. Everything here ends up in the browser bundle:
# never put a secret in a VITE_ variable. trustledger-web is a public client, so there is no client secret.

# Base URLs without /api/v1 (the API client adds it).
VITE_CORE_API_URL=http://localhost:8080
VITE_AML_API_URL=http://localhost:8081

# Keycloak realm (issuer) and the public PKCE client from infra/keycloak/realm-trustledger.json.
VITE_OIDC_AUTHORITY=http://localhost:8180/realms/trustledger
VITE_OIDC_CLIENT_ID=trustledger-web

# Landing page links (empty = hidden).
VITE_GITHUB_URL=
VITE_VIDEO_URL=
