# Copy to .env (git-ignored) and change the values. Local development only.
# Read by infra/docker-compose.yml (env_file) and by the apps' "local" profile.

POSTGRES_DB=trustledger
POSTGRES_USER=trustledger
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

# Keycloak admin console (http://localhost:8180)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Field encryption (AES-256-GCM) and blind index (HMAC-SHA256) keys for core-app.
# Each must be base64 of 32 random bytes, and the two must differ. Generate with:
#   openssl rand -base64 32
TRUSTLEDGER_CRYPTO_KEY=change-me
TRUSTLEDGER_CRYPTO_INDEX_KEY=change-me
