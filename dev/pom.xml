<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.trustledger</groupId>
    <artifactId>trustledger-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>TrustLedger</name>
    <description>Regulated digital wallet: modular monolith core-app plus risk-aml-service</description>

    <modules>
        <module>event-contracts</module>
        <module>core-app</module>
        <module>risk-aml-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-modulith.version>2.1.2</spring-modulith.version>
        <!-- Also drives the Testcontainers BOM imported by spring-boot-dependencies. -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <!--
          Run every JVM in UTC (spec: Instant in code, timestamptz UTC in DB).
          Also avoids Windows JVMs sending the legacy zone "Asia/Calcutta" to PostgreSQL,
          which postgres:17 rejects at connect time. Surefire reads ${argLine}; later
          agents (e.g. JaCoCo) append to it.
        -->
        <app.jvm.timezone>-Duser.timezone=UTC</app.jvm.timezone>
        <argLine>${app.jvm.timezone}</argLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.trustledger</groupId>
                <artifactId>event-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <jvmArguments>${app.jvm.timezone}</jvmArguments>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
