<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.trustledger</groupId>
    <artifactId>trustledger-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>TrustLedger</name>
    <description>Regulated digital wallet: modular monolith core-app plus risk-aml-service</description>

    <modules>
        <module>event-contracts</module>
        <module>core-app</module>
        <module>risk-aml-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <spring-modulith.version>2.1.2</spring-modulith.version>
        <!-- Also drives the Testcontainers BOM imported by spring-boot-dependencies. -->
        <testcontainers.version>2.0.5</testcontainers.version>
        <!--
          Run every JVM in UTC (spec: Instant in code, timestamptz UTC in DB).
          Also avoids Windows JVMs sending the legacy zone "Asia/Calcutta" to PostgreSQL,
          which postgres:17 rejects at connect time. Surefire reads ${argLine}; later
          agents (e.g. JaCoCo) append to it.
        -->
        <app.jvm.timezone>-Duser.timezone=UTC</app.jvm.timezone>
        <argLine>${app.jvm.timezone}</argLine>

        <!-- ./mvnw verify -DskipUnitTests runs only the Failsafe *IT classes. -->
        <skipUnitTests>false</skipUnitTests>
        <jacoco.version>0.8.16</jacoco.version>
        <springdoc.version>3.2.0</springdoc.version>
        <!-- Rate limiting (CLAUDE.md stack). 8.21.0: newest release older than two weeks on Day 4. -->
        <bucket4j.version>8.21.0</bucket4j.version>
        <!-- KYC document storage in S3 (ADR 0011). 2.56.0: released 2026-10-14, a month before Day 5. -->
        <aws-sdk.version>2.56.0</aws-sdk.version>
        <!-- Scheduled-job lock (ADR 0013). 7.10.1: released 2026-09-08, built against Spring 7.0 / Boot 4.1;
             7.11.0 was under two weeks old on Day 8. -->
        <shedlock.version>7.10.1</shedlock.version>
        <!-- Payment-gateway resilience (ADR 0014): core modules only, configured in code from trustledger.razorpay.*.
             2.4.0: released 2026-03-14. -->
        <resilience4j.version>2.4.0</resilience4j.version>
        <!-- Razorpay stubs in tests (ADR 0014). 3.13.2: newest stable (4.x is still beta), released 2025-11-14. -->
        <wiremock.version>3.13.2</wiremock.version>
        <!-- Logback events to the OpenTelemetry log exporter (ADR 0020). 2.28.1-alpha: the instrumentation release
             built against opentelemetry-api 1.62.0, the version Boot 4.1.2 manages (newer ones need a newer API). -->
        <otel-logback-appender.version>2.28.1-alpha</otel-logback-appender.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.trustledger</groupId>
                <artifactId>event-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j_jdk17-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j_jdk17-lettuce</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-logback-appender-1.0</artifactId>
                <version>${otel-logback-appender.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-bom</artifactId>
                <version>${shedlock.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <jvmArguments>${app.jvm.timezone}</jvmArguments>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Unit tests: fast, no containers. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>${skipUnitTests}</skip>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- Integration tests (Testcontainers). Goals are bound by spring-boot-starter-parent. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!--
              Coverage: prepare-agent prepends the agent to ${argLine}, which both Surefire and
              Failsafe use, so unit + integration coverage land in one jacoco.exec per module.
              report runs on verify -> target/site/jacoco/index.html.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
